# Copy this file to .env and fill in real values. Never commit .env to Git.

# FastAPI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173

# Supabase
# SUPABASE_PUBLISHABLE_KEY: the publishable (formerly anon) key — safe for backend reads
# SUPABASE_SECRET_KEY: the secret (formerly service_role) key — needed ONLY for running migrations/seeding
#   Find both keys at: Supabase Dashboard → Project Settings → API → Project API Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxx

# Demo mode — set to false when DB and ML are connected
DEMO_MODE=true

# ML model artifact path (relative to backend/)
ML_MODEL_PATH=../ml/artifacts/model.joblib
