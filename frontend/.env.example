# ============================================================
# HeatShield frontend — environment variables
# ============================================================
# Copy this file to .env and fill in your values.
# The .env file is gitignored and must never be committed.
#
# SECURITY RULES:
#   - Never put SUPABASE_SERVICE_KEY or SUPABASE_ANON_KEY here.
#   - Never put any backend secret here.
#   - VITE_ prefix exposes the value to the browser — keep it
#     to public configuration only (API URL).
# ============================================================

# Base URL of the HeatShield FastAPI backend (Member 2 owns this).
# Set to the address where FastAPI is running.
# Example (local development):
VITE_API_BASE_URL=http://localhost:8000/api/v1

# When this variable is unset or empty, the frontend automatically
# falls back to clearly-labelled synthetic demo data so the UI
# can be developed independently of the backend.
