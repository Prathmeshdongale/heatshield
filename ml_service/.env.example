# ML Service configuration — copy to .env and fill in values
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8001

# Data / Model directories
MODEL_DIR=data/models
DATA_DIR=data
REPORTS_DIR=data/reports

# Feature engineering
TARGET_COLUMN=ed_visits_heat
DATE_COLUMN=date
HEATWAVE_TEMP_THRESHOLD=28.0
MISSING_WEATHER_STRATEGY=mean

# Logging
LOG_LEVEL=INFO
